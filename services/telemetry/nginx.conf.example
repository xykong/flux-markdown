# Install only after t.xykong.cc DNS and trusted certificate are ready.
# Place in nginx http context. No event query API is exposed.
limit_req_zone $binary_remote_addr zone=flux_events:1m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=flux_connections:1m;
server {
    listen 443 ssl;
    server_name t.xykong.cc;
    ssl_certificate /etc/letsencrypt/live/t.xykong.cc/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/t.xykong.cc/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    # Avoid retaining client addresses and malformed request contents in logs.
    error_log /dev/null;
    client_max_body_size 64k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 10s;
    location = /v1/events {
        limit_except POST { deny all; }
        limit_req zone=flux_events burst=10 nodelay;
        limit_req_status 429;
        limit_conn flux_connections 4;
        proxy_request_buffering on;
        proxy_pass http://127.0.0.1:8765;
        proxy_connect_timeout 2s;
        proxy_read_timeout 15s;
    }
    location / { return 404; }
}
