{
  "name": "markdown-quicklook-renderer",
  "version": "1.0.0",
  "description": "Web renderer for macOS Quick Look Extension",
  "main": "index.js",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "jest",
    "playground": "vite --port 5174 --open /playground.html",
    "typecheck": "tsc --noEmit",
    "dev": "vite"
  },
  "dependencies": {
    "@hpcc-js/wasm-graphviz": "^1.21.0",
    "@iktakahiro/markdown-it-katex": "^4.0.1",
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0-rc2",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0-rc2",
    "@myriaddreamin/typst.ts": "^0.7.0-rc2",
    "diff": "^9.0.0",
    "dompurify": "3.4.16",
    "github-markdown-css": "^5.2.0",
    "highlight.js": "^11.7.0",
    "js-yaml": "4.3.2",
    "katex": "0.19.0",
    "markdown-it": "14.3.2",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-emoji": "^2.0.2",
    "markdown-it-footnote": "^3.0.3",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-mark": "^3.0.1",
    "markdown-it-sub": "^1.0.0",
    "markdown-it-sup": "^1.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.12.2",
    "tex2typst": "^0.6.0",
    "vega": "^6.2.0",
    "vega-lite": "^6.4.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "overrides": {
    "katex": "$katex",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "$js-yaml"
    }
  }
}
