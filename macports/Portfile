# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           xcode 1.0

github.setup        xykong flux-markdown 1.42.645 v
github.tarball_from releases

categories          aqua sysutils
platforms           {darwin >= 21}
supported_archs     x86_64 arm64
macosx_deployment_target 12.0
license             GPL-3
maintainers         {@xykong gmail.com:xy.kong} openmaintainer

description         Markdown previews in Finder QuickLook with diagrams and math
long_description    FluxMarkdown is a macOS QuickLook extension for Markdown files. \
                    It renders Mermaid diagrams, KaTeX math, GitHub Flavored Markdown \
                    (including Alerts), syntax-highlighted code blocks, Vega/Vega-Lite \
                    charts, and Graphviz DOT diagrams. Features include an interactive \
                    table of contents, YAML frontmatter display, PDF and HTML export, \
                    zoom, scroll position memory, and light/dark/system themes.

# MacPorts-specific source tarball: pre-generated .xcodeproj, pre-built
# web-renderer/dist, and Sparkle removed (MacPorts manages updates).
# Generated by scripts/create_macports_tarball.sh during the release process.
distname            FluxMarkdown-${version}-macports-source
worksrcdir          FluxMarkdown-${version}
extract.suffix      .tar.gz

checksums           rmd160  9971a8695d87c94302fbb50e887fc8738f1b0957 \
                    sha256  86021fd780fdd02c85c64312fde74bb99cd9e08513e19782edbdae8b3d5c9cf6 \
                    size    23993892

# The xcode PortGroup owns build and staged installation. Preserve the
# project's per-target entitlements for the Quick Look extension and helpers.
xcode.project       FluxMarkdown.xcodeproj
xcode.scheme        Markdown
xcode.configuration Release
# Keep Xcode logs/caches inside the MacPorts sandbox.
build.pre_args      -derivedDataPath ${workpath}/DerivedData
destroot.pre_args   {*}${build.pre_args}
# Swift macro subprocesses cannot nest sandbox-exec inside MacPorts' sandbox.
# Keep MacPorts' outer sandbox enabled; only disable the nested compiler sandbox.
xcode.build.settings \
                    OTHER_SWIFT_FLAGS=-disable-sandbox \
                    CODE_SIGN_IDENTITY=- \
                    CODE_SIGNING_REQUIRED=NO \
                    AD_HOC_CODE_SIGNING_ALLOWED=YES \
                    MARKETING_VERSION=${version}
xcode.destroot.settings {*}${xcode.build.settings}

notes "Open ${applications_dir}/FluxMarkdown.app once after installation. \
       If Finder previews need recovery, use Help > Repair Quick Look in the app. \
       This build uses MacPorts for updates; Sparkle is not included."
