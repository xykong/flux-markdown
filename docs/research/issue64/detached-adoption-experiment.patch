diff --git a/web-renderer/test/math-inplace-output.test.ts b/web-renderer/test/math-inplace-output.test.ts
new file mode 100644
index 0000000..2bb9fe3
--- /dev/null
+++ b/web-renderer/test/math-inplace-output.test.ts
@@ -0,0 +1,19 @@
+import { sanitizeMathOutput } from '../src/safe-html';
+
+test('detached generated output can be sanitized in place without retaining forbidden nodes', () => {
+    const node=document.createElement('div');
+    node.innerHTML='<mjx-container><svg><path d="M0 0L1 1"></path><image href="https://invalid.example/image.svg"></image></svg><mjx-assistive-mml><math><mi>x</mi></math></mjx-assistive-mml></mjx-container><script>bad()</script>';
+    const result=(sanitizeMathOutput as (html:string,node:HTMLElement)=>ReturnType<typeof sanitizeMathOutput>)(node.innerHTML,node);
+    expect(node.querySelector('image,script')).toBeNull();
+    expect(result.blockedResources).toBe(true);
+    expect(result.paths).toBe(1);
+    expect(result.formulas).toBe(1);
+    expect(result.html).toBe(node.innerHTML);
+    expect(node.querySelector('math')?.namespaceURI).toBe('http://www.w3.org/1998/Math/MathML');
+});
+
+test('in-place sanitization refuses connected nodes', () => {
+    const node=document.createElement('div');document.body.append(node);
+    try { expect(()=>(sanitizeMathOutput as (html:string,node:HTMLElement)=>unknown)('',node)).toThrow('detached'); }
+    finally {node.remove();}
+});
diff --git a/web-renderer/test/math-dom-transfer.test.ts b/web-renderer/test/math-dom-transfer.test.ts
new file mode 100644
index 0000000..0acaf1d
--- /dev/null
+++ b/web-renderer/test/math-dom-transfer.test.ts
@@ -0,0 +1,25 @@
+jest.mock('mermaid', () => ({ initialize: jest.fn(), render: jest.fn() }));
+import '../src/index';
+
+test('publishes sanitized math without reparsing its serialized SVG and MathML', async () => {
+    document.body.innerHTML='<div id="markdown-preview"></div>';
+    const setter=Object.getOwnPropertyDescriptor(Element.prototype,'innerHTML')!.set!;
+    const reparsed: string[]=[];
+    const spy=jest.spyOn(Element.prototype,'innerHTML','set').mockImplementation(function(this:Element,value:string){
+        if(this.matches('.flux-math-source')&&value.includes('mjx-container')) {
+            reparsed.push(value);
+            throw new Error('Mathematical output was parsed a second time');
+        }
+        setter.call(this,value);
+    });
+    try {
+        await window.renderMarkdown(String.raw`\(\eqref{a}\)`+'\n\n'+String.raw`\[x=1\tag{A}\label{a}\]`);
+        expect(document.querySelectorAll('mjx-container')).toHaveLength(2);
+        expect(document.querySelector('.math-error')).toBeNull();
+        expect(reparsed).toHaveLength(0);
+        expect(document.querySelector('math')?.namespaceURI).toBe('http://www.w3.org/1998/Math/MathML');
+        const link=document.querySelector<HTMLAnchorElement>('a.math-reference-link')!;
+        expect(document.getElementById(decodeURIComponent(link.hash.slice(1)))).not.toBeNull();
+        await window.waitForExportReady();
+    } finally { spy.mockRestore(); }
+});
diff --git a/web-renderer/test/math-stage-layout.test.ts b/web-renderer/test/math-stage-layout.test.ts
new file mode 100644
index 0000000..f1832b4
--- /dev/null
+++ b/web-renderer/test/math-stage-layout.test.ts
@@ -0,0 +1,22 @@
+import { renderMathSources } from '../src/math-engine';
+import { SVG } from '@mathjax/src/js/output/svg.js';
+
+test('measures in the native document but typesets without a connected hidden output tree',async()=>{
+    const originalMetrics=SVG.prototype.getMetrics;
+    const originalTypeset=SVG.prototype.typeset;
+    let measured=false, detached=false;
+    const metrics=jest.spyOn(SVG.prototype,'getMetrics').mockImplementation(function(doc){
+        measured=!!document.querySelector('[data-math-measurement]');
+        return originalMetrics.call(this,doc);
+    });
+    const typeset=jest.spyOn(SVG.prototype,'typeset').mockImplementation(function(math,doc){
+        detached=!document.querySelector('[data-math-measurement]');
+        return originalTypeset.call(this,math,doc);
+    });
+    try {
+        const result=await renderMathSources([{id:'native',kind:'tex',raw:'x=1',payload:'x=1',display:true,firstLine:1,lastLine:1}],'native-layout');
+        expect(result.errors).toEqual([]);expect(result.items[0].html).toContain('mjx-container');
+        expect(measured).toBe(true);expect(detached).toBe(true);
+        expect(document.querySelector('[data-math-measurement]')).toBeNull();
+    } finally {metrics.mockRestore();typeset.mockRestore();}
+});
