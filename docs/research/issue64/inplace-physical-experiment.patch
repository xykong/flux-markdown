--- /dev/null
+++ b/web-renderer/test/math-inplace-output.test.ts
@@ -0,0 +1,19 @@
+import { sanitizeMathOutput } from '../src/safe-html';
+
+test('detached generated output can be sanitized in place without retaining forbidden nodes', () => {
+    const node=document.createElement('div');
+    node.innerHTML='<mjx-container><svg><path d="M0 0L1 1"></path><image href="https://invalid.example/image.svg"></image></svg><mjx-assistive-mml><math><mi>x</mi></math></mjx-assistive-mml></mjx-container><script>bad()</script>';
+    const result=(sanitizeMathOutput as (html:string,node:HTMLElement)=>ReturnType<typeof sanitizeMathOutput>)(node.innerHTML,node);
+    expect(node.querySelector('image,script')).toBeNull();
+    expect(result.blockedResources).toBe(true);
+    expect(result.paths).toBe(1);
+    expect(result.formulas).toBe(1);
+    expect(result.html).toBe(node.innerHTML);
+    expect(node.querySelector('math')?.namespaceURI).toBe('http://www.w3.org/1998/Math/MathML');
+});
+
+test('in-place sanitization refuses connected nodes', () => {
+    const node=document.createElement('div');document.body.append(node);
+    try { expect(()=>(sanitizeMathOutput as (html:string,node:HTMLElement)=>unknown)('',node)).toThrow('detached'); }
+    finally {node.remove();}
+});
