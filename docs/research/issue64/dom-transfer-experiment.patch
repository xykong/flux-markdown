diff --git a/web-renderer/test/math-dom-transfer.test.ts b/web-renderer/test/math-dom-transfer.test.ts
new file mode 100644
index 0000000..0acaf1d
--- /dev/null
+++ b/web-renderer/test/math-dom-transfer.test.ts
@@ -0,0 +1,25 @@
+jest.mock('mermaid', () => ({ initialize: jest.fn(), render: jest.fn() }));
+import '../src/index';
+
+test('publishes sanitized math without reparsing its serialized SVG and MathML', async () => {
+    document.body.innerHTML='<div id="markdown-preview"></div>';
+    const setter=Object.getOwnPropertyDescriptor(Element.prototype,'innerHTML')!.set!;
+    const reparsed: string[]=[];
+    const spy=jest.spyOn(Element.prototype,'innerHTML','set').mockImplementation(function(this:Element,value:string){
+        if(this.matches('.flux-math-source')&&value.includes('mjx-container')) {
+            reparsed.push(value);
+            throw new Error('Mathematical output was parsed a second time');
+        }
+        setter.call(this,value);
+    });
+    try {
+        await window.renderMarkdown(String.raw`\(\eqref{a}\)`+'\n\n'+String.raw`\[x=1\tag{A}\label{a}\]`);
+        expect(document.querySelectorAll('mjx-container')).toHaveLength(2);
+        expect(document.querySelector('.math-error')).toBeNull();
+        expect(reparsed).toHaveLength(0);
+        expect(document.querySelector('math')?.namespaceURI).toBe('http://www.w3.org/1998/Math/MathML');
+        const link=document.querySelector<HTMLAnchorElement>('a.math-reference-link')!;
+        expect(document.getElementById(decodeURIComponent(link.hash.slice(1)))).not.toBeNull();
+        await window.waitForExportReady();
+    } finally { spy.mockRestore(); }
+});
