diff --git a/web-renderer/src/math-scheduler.ts b/web-renderer/src/math-scheduler.ts
new file mode 100644
--- /dev/null
+++ b/web-renderer/src/math-scheduler.ts
@@ -0,0 +1,20 @@
+/** Let the browser process pending work between large mathematical documents.
+ * MessageChannel avoids background-window timer throttling in native WebKit.
+ * This yields once; it does not interrupt synchronous MathJax compilation.
+ */
+export function yieldMathTask(): Promise<void> {
+    return new Promise(resolve => {
+        if (typeof MessageChannel === 'undefined') {
+            setTimeout(resolve, 0);
+            return;
+        }
+        const channel = new MessageChannel();
+        channel.port1.onmessage = () => {
+            channel.port1.onmessage = null;
+            channel.port1.close();
+            channel.port2.close();
+            resolve();
+        };
+        channel.port2.postMessage(null);
+    });
+}
diff --git a/web-renderer/test/math-scheduler.test.ts b/web-renderer/test/math-scheduler.test.ts
new file mode 100644
--- /dev/null
+++ b/web-renderer/test/math-scheduler.test.ts
@@ -0,0 +1,14 @@
+import { yieldMathTask } from '../src/math-scheduler';
+
+afterEach(() => jest.useRealTimers());
+
+test('yields to a task rather than resolving in the current microtask queue', async () => {
+    jest.useFakeTimers();
+    let completed = false;
+    const pending = yieldMathTask().then(() => { completed = true; });
+    await Promise.resolve();
+    expect(completed).toBe(false);
+    jest.runOnlyPendingTimers();
+    await pending;
+    expect(completed).toBe(true);
+});
